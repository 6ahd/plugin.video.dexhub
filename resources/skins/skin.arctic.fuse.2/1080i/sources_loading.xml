<!-- Dex Hub 4.6.1 source-search — cinematic editorial dashboard.

     Full-bleed item fanart stays visible (no boxed panel): a left reading
     scrim plus a bottom shelf gradient carry the text, and the provider
     cards float as translucent glass over the art. Each provider shows its
     stable identity colour, live result count and waiting/done/no-results
     state from the first paint.

     Contract kept with sources_loading.py (do not rename):
       controls  5101 fanart · 5102 poster(compat) · 5103 clearlogo
                 9001 show-now · 9002 keep-searching · 9000 cancel
       props     status, counter_number, results_line, current_provider,
                 progress_pct, progress_label, completed_count,
                 provider_count, providers_short_label, counter_label,
                 enough_state, enough_label, hint_line, elapsed_label,
                 has_results, sufficient_label, continue_label,
                 cancel_label, eyebrow, title, subtitle,
                 pv1..pv8 _name/_count/_state/_coloridx, pv_more,
                 pv_state_wait_label / _done_label / _zero_label

     Progress bar: righttexture paints the REMAINDER at full control width
     in Kodi — it must stay transparent, texturebg is the rail. --><window>
    <defaultcontrol always="true">9000</defaultcontrol>
    <controls>
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <texture colordiffuse="FF04070D">$INFO[Window(Home).Property(dexhub.assetroot)]/resources/media/black.png</texture>
        </control>
        <control type="image" id="5101">
            <left>-36</left><top>-24</top><width>1992</width><height>1128</height>
            <aspectratio>scale</aspectratio>
            <texture background="true">$INFO[Window.Property(dexhub.loading.fanart)]</texture>
            <animation effect="fade" start="0" end="100" time="420" tween="sine">WindowOpen</animation>
        </control>
        <!-- v4.6.2: reading scrims — ONE soft global veil plus the bottom
             shelf gradient. The 4.6.1 left scrim block drew a hard vertical
             seam across the art; text legibility now comes from the shelf,
             per-card backgrounds and heavy label shadows instead. -->
        <!-- v5.10.165: the veil (60000000) and the shelf scrim (top 330) in one layer:
             veil_loading.png is the two blended (the same picture, one full screen pass less) -->
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <texture>$INFO[Window(Home).Property(dexhub.assetroot)]/resources/media/veil_loading.png</texture>
        </control>

        <!-- Header -->
        <control type="label">
            <left>62</left><top>36</top><width>300</width><height>42</height>
            <font>font_midi</font><textcolor>FFFFFFFF</textcolor>
            <label>[B]DEX[/B] [COLOR $INFO[Window(Home).Property(dexhub.tvos.theme.accent)]][B]HUB[/B][/COLOR]</label>
        </control>
        <control type="label">
            <left>356</left><top>39</top><width>680</width><height>38</height>
            <font>font_mini</font><textcolor>FFC5CCD8</textcolor>
            <label>|   $INFO[Window.Property(eyebrow)]</label>
        </control>
        <control type="label">
            <left>1600</left><top>38</top><width>250</width><height>38</height>
            <font>font_main</font><align>right</align><textcolor>FFE9EDF4</textcolor>
            <label>$INFO[System.Time]</label>
        </control>

        <!-- Item identity -->
        <control type="image" id="5103">
            <left>70</left><top>96</top><width>900</width><height>240</height>
            <aspectratio align="left" aligny="center">keep</aspectratio>
            <texture background="true">$INFO[Window.Property(dexhub.loading.clearlogo)]</texture>
            <visible>!String.IsEmpty(Window.Property(dexhub.loading.clearlogo))</visible>
        </control>
        <control type="label">
            <left>70</left><top>120</top><width>1200</width><height>190</height>
            <font>font_huge_bold</font><textcolor>FFFFFFFF</textcolor><shadowcolor>FF000000</shadowcolor>
            <wrapmultiline>true</wrapmultiline>
            <label>$INFO[Window.Property(title)]</label>
            <visible>String.IsEmpty(Window.Property(dexhub.loading.clearlogo))</visible>
        </control>
        <control type="label">
            <left>72</left><top>344</top><width>1200</width><height>32</height>
            <font>font_mini</font><textcolor>FFD3D9E3</textcolor><shadowcolor>FF000000</shadowcolor>
            <label>$INFO[Window.Property(subtitle)]</label>
        </control>

        <!-- Status block -->
        <control type="label">
            <left>70</left><top>400</top><width>1080</width><height>52</height>
            <font>font_head_bold</font><textcolor>FFFFFFFF</textcolor><shadowcolor>EE000000</shadowcolor>
            <label>$INFO[Window.Property(status)]</label>
        </control>
        <control type="label">
            <left>72</left><top>454</top><width>1080</width><height>36</height>
            <font>font_mini</font><textcolor>FFD7DCE5</textcolor><shadowcolor>EE000000</shadowcolor>
            <label>[COLOR $INFO[Window(Home).Property(dexhub.tvos.theme.accent)]][B]$INFO[Window.Property(counter_number)][/B][/COLOR]  $INFO[Window.Property(results_line)]</label>
        </control>
        <control type="label">
            <left>72</left><top>494</top><width>1080</width><height>30</height>
            <font>font_mini</font><textcolor>FF9FC4D4</textcolor><shadowcolor>EE000000</shadowcolor>
            <label>$INFO[Window.Property(current_provider)]</label>
        </control>

        <!-- v4.6.2: hand-drawn bar. Kodi's <progress> caps render at the
             raw texture size and ignore transparent diffuse (the white block
             bug) — so the rail is a plain image and the fill (5110) gets its
             width set from sources_loading.py on every update. -->
        <control type="image">
            <left>70</left><top>542</top><width>1000</width><height>8</height>
            <texture border="4" colordiffuse="9A262D45">$INFO[Window(Home).Property(dexhub.assetroot)]/resources/media/circle.png</texture>
        </control>
        <control type="image" id="5110">
            <left>70</left><top>542</top><width>10</width><height>8</height>
