            <texture>$INFO[Window(Home).Property(dexhub.assetroot)]/resources/media/brand_bar.png</texture>
        </control>
        <control type="label">
            <left>1090</left><top>528</top><width>760</width><height>34</height>
            <font>font_mini</font><textcolor>FFE9EDF4</textcolor><shadowcolor>EE000000</shadowcolor>
            <label>[B]$INFO[Window.Property(progress_label)][/B]   ·   $INFO[Window.Property(completed_count)] / $INFO[Window.Property(provider_count)] $INFO[Window.Property(providers_short_label)]   ·   $INFO[Window.Property(elapsed_label)]</label>
        </control>

