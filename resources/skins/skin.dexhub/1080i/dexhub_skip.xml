<?xml version="1.0" encoding="UTF-8"?>
<!-- v5.10.383: a white rounded rectangle with black text, as Apple TV and Netflix. The texture path is
     written out: Kodi reads a button's textures literally, so the old $INFO[...assetroot] path never
     loaded and the button showed only its dark text. -->
<window>
 <defaultcontrol always="true">100</defaultcontrol>
 <coordinates>
  <system>1</system>
  <width>1920</width>
  <height>1080</height>
 </coordinates>
 <animation effect="fade" start="0" end="100" time="320" tween="sine">WindowOpen</animation>
 <animation effect="fade" start="100" end="0" time="200">WindowClose</animation>
 <controls>
  <control type="button" id="100">
   <left>1472</left>
   <top>866</top>
   <width>328</width>
   <height>74</height>
   <font>af3_font_main_bold</font>
   <align>center</align>
   <aligny>center</aligny>
   <textcolor>FF000000</textcolor>
   <focusedcolor>FF000000</focusedcolor>
   <selectedcolor>FF000000</selectedcolor>
   <disabledcolor>FF48494C</disabledcolor>
   <shadowcolor>00000000</shadowcolor>
   <texturefocus border="16" colordiffuse="FFFFFFFF">special://home/addons/plugin.video.dexhub/resources/media/homeui/skip_rect.png</texturefocus>
   <texturenofocus border="16" colordiffuse="FFFFFFFF">special://home/addons/plugin.video.dexhub/resources/media/homeui/skip_rect.png</texturenofocus>
   <pulseonselect>false</pulseonselect>
   <onleft>100</onleft>
   <onright>100</onright>
   <onup>100</onup>
   <ondown>100</ondown>
  </control>
 </controls>
</window>
